# Arihant Travel — environment configuration template
# Copy this file to ".env" (one level above public_html if your host allows it,
# otherwise in the project root) and fill in real values. Never commit the real .env.
#
# After editing, rotate any old credentials in Hostinger:
#   - MySQL password (Database -> Manage)
#   - shweta@arihantlink.com mailbox password (Email -> Manage)
# DB and SMTP must use DIFFERENT passwords going forward.

# --- Database (MySQL on Hostinger) ---
DB_HOST=srv1331.hstgr.io
DB_NAME=u166882835_arihantdb_php
DB_USER=u166882835_arihanlink_usr
DB_PASS=replace_me_with_new_db_password

# --- Outbound SMTP (Hostinger mailbox) ---
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USER=shweta@arihantlink.com
SMTP_PASS=replace_me_with_new_mail_password
SMTP_FROM=contact@arihantlink.com
SMTP_FROM_NAME=Arihant Travel

# --- Notifications ---
CONTACT_INBOX=contact@arihantlink.com
ADMIN_NOTIFY_INBOX=jainn.neeraj@gmail.com

# --- Environment ---
APP_ENV=production
# Set to 1 to expose verbose error info from API endpoints. Leave 0 in prod.
APP_DEBUG=0

# --- Security ---
# Optional: comma-separated list of origins allowed to call POST endpoints.
# Default behaviour is "same-origin only".
ALLOWED_ORIGINS=https://arihantlink.com

# Optional: Google reCAPTCHA v3 keys (get them from https://www.google.com/recaptcha/admin)
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
